	option network 'WIFI_WAN'
	option masq '1'
	option mtu_fix '1'
	option extra_src '-m policy --dir in --pol none'
	option extra_dest '-m policy --dir out --pol none'

config forwarding 'wifiwifiwan'
	option src 'ra0'
	option dest 'WIFI_WAN'

config redirect
	option target 'DNAT'
	option proto 'tcp udp'
	option dest 'SW_LAN'
	option name 'AB'
	option src 'VPN'
	option src_dport '3001'
	option dest_ip '10.20.27.50'
	option dest_port '3001'

config redirect
	option target 'DNAT'
	option proto 'tcp udp'
	option dest 'SW_LAN'
	option name 'SECC'
