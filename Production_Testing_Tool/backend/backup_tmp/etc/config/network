
config interface 'loopback'
	option ifname 'lo'
	option proto 'static'
	option ip_int_instance '6'

config switch 'switch0'
	option enable_vlan '1'
	option name 'switch0'
	option reset '1'

config interface 'VPN'
	option proto 'none'
	option ifname 'tun0'
	option ip_int_instance '2'

config switch_vlan '1'
	option device 'switch0'
	option vlan '1'
	option ports '0 1 2 3  6t'

config switch_vlan '5'
	option device 'switch0'
	option vlan '5'
	option ports '4  6t'

config interface 'ra0'
	option ipaddr '192.168.100.1'
	option netmask '255.255.255.0'
	option proto 'static'
	option ifname 'ra0'
	option ip_int_instance '7'

config interface 'WIFI_WAN'
	option proto 'dhcp'
	option metric '4'
	option ifname 'apcli0'
	option ip_int_instance '8'

config interface 'SW_LAN'
	option ifname 'eth0.1'
	option proto 'static'
	option ipaddr '10.20.27.1'
	option netmask '255.255.255.0'
	option macaddr 'D0:93:95:B1:C5:2B'
	list dns '8.8.8.8'
	option ip_int_instance '9'

config interface 'EWAN5'
	option ifname 'eth0.5'
	option proto 'dhcp'
	option gateway '10.1.1.1'
	option macaddr 'D0:93:95:B1:C5:2A'
	option metric '1'
	option ip_int_instance '10'
